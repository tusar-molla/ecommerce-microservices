# Copy this file to ".env" (same folder as docker-compose.yml) and fill in the values.
# ".env" is git-ignored. Never commit it.

# --- SQL Server (sa account) ---
# 8+ characters with upper case, lower case, a digit and a symbol.
# Avoid these characters: ; = " ' $ and spaces (they break connection strings or .env parsing).
SA_PASSWORD=ChangeMe_Str0ngPassw0rd

# --- Shared by every service ---
# Any random string, 32+ characters. Same value is used by all services automatically.
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
# Any random string. Protects the internal service-to-service endpoints.
INTERNAL_API_KEY=replace-with-another-random-string

# --- RabbitMQ (optional, defaults to guest / guest) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Payment: SSLCommerz sandbox (https://developer.sslcommerz.com) ---
SSLCOMMERZ_STORE_ID=your-sandbox-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sandbox-store-password
# Public URL that reaches payment-service (the ngrok URL). Needed only to test real payments.
PAYMENT_PUBLIC_BASE_URL=http://localhost:8085

# --- Notification: Mailtrap sandbox inbox (https://mailtrap.io) ---
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
