{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity":      { "ClusterId": "identity",  "Match": { "Path": "/api/auth/{**catch-all}" } },
      "catalog":       { "ClusterId": "catalog",   "Match": { "Path": "/api/products/{**catch-all}" } },
      "categories":    { "ClusterId": "catalog",   "Match": { "Path": "/api/categories/{**catch-all}" } },
      "images":        { "ClusterId": "catalog",   "Match": { "Path": "/images/{**catch-all}" } },
      "cart":          { "ClusterId": "order",     "Match": { "Path": "/api/cart/{**catch-all}" } },
      "orders":        { "ClusterId": "order",     "Match": { "Path": "/api/orders/{**catch-all}" } },
      "stock":         { "ClusterId": "inventory", "Match": { "Path": "/api/stock/{**catch-all}" } },
      "stock-levels":  { "ClusterId": "inventory", "Match": { "Path": "/api/stock-levels/{**catch-all}" } },
      "payments":      { "ClusterId": "payment",   "Match": { "Path": "/api/payments/{**catch-all}" } }
    },
    "Clusters": {
      "identity":  { "Destinations": { "d1": { "Address": "http://identity-service:8080/" } } },
      "catalog":   { "Destinations": { "d1": { "Address": "http://catalog-service:8080/" } } },
      "order":     { "Destinations": { "d1": { "Address": "http://order-service:8080/" } } },
      "inventory": { "Destinations": { "d1": { "Address": "http://inventory-service:8080/" } } },
      "payment":   { "Destinations": { "d1": { "Address": "http://payment-service:8080/" } } }
    }
  }
}
